DirectoryIndex index.php

# Datenbank- und Doku-Dateien nie ausliefern (Apache 2.4 und 2.2)
<FilesMatch "\.(sqlite|sqlite-journal|sqlite-wal|sqlite-shm|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
